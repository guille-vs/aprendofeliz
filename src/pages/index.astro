---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Pillars from "../components/Pillars.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Modules from "../components/Modules.astro";
import PhotoBand from "../components/PhotoBand.astro";
import Faq from "../components/Faq.astro";
import Testimonial from "../components/Testimonial.astro";
import CtaBand from "../components/CtaBand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import GiaWidget from "../components/GiaWidget.astro";
---

<BaseLayout
	title="Aprendo Feliz — plataforma de e-learning para academias"
	description="Aprendo Feliz: la plataforma para que tu academia publique cursos, cobre matrículas y enseñe en línea con tu propia marca y tu propio subdominio."
>
	<SiteHeader />
	<main>
		<Hero />
		{/* TrustStrip deshabilitado: aún no hay academias registradas */}
		{/* <TrustStrip /> */}
		<Pillars />
		<HowItWorks />
		<Modules />
		<PhotoBand />
		<Faq />
		{/* Testimonial deshabilitado: todavía no hay testimonios */}
		{/* <Testimonial /> */}
		<CtaBand />
	</main>
	<SiteFooter />
	<GiaWidget />
</BaseLayout>
