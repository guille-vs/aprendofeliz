---
import Icon from "./Icon.astro";

const academies = [
	{ icon: "school", name: "Academia Nova Bogotá" },
	{ icon: "workspace_premium", name: "Instituto Líder Lima" },
	{ icon: "terminal", name: "Escuela Digital CDMX" },
	{ icon: "trending_up", name: "Cursos Avanza Santiago" },
	{ icon: "brush", name: "Talento Creativo BA" },
];
---

<section class="trust">
	<div class="section-inner">
		<p class="label">Academias que ya enseñan con Aprendo Feliz</p>
		<ul class="logos">
			{
				academies.map((academy) => (
					<li>
						<Icon name={academy.icon} size={22} color="var(--logo-navy)" />
						<span>{academy.name}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.trust {
		background: var(--white);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding: 48px var(--gutter);
	}

	.section-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
	}

	.label {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 1.5px;
		color: var(--ink-medium);
		text-align: center;
	}

	.logos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 40px;
	}

	.logos li {
		display: flex;
		align-items: center;
		gap: 8px;
		opacity: 0.75;
		font-size: 14px;
		font-weight: 700;
		color: var(--logo-navy);
	}

	@media (max-width: 640px) {
		.logos {
			gap: 20px 28px;
		}
	}
</style>
