---
// Placeholder photography carried over from the design file (Unsplash).
// Replace with owned imagery before going to production.
const photoUrl =
	"https://images.unsplash.com/photo-1758270704464-f980b03b9633?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3ODg3MjQ5NzR8&ixlib=rb-4.1.0&q=80&w=1080";
---

<section class="photo-band">
	<div class="section-inner">
		<div class="frame" style={`background-image:url('${photoUrl}')`}>
			<div class="overlay">
				<div class="content">
					<p class="pill">COMUNIDAD EDUCATIVA</p>
					<h2>
						Construido para educadores apasionados en toda América Latina
					</h2>
					<p class="desc">
						Permitiendo a miles de formadores monetizar su conocimiento con
						herramientas que se adaptan a la realidad y formas de pago locales.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.photo-band {
		padding: 24px var(--gutter) 64px;
	}

	.frame {
		position: relative;
		height: 440px;
		border: 1px solid var(--line);
		border-radius: 20px;
		overflow: hidden;
		background-size: cover;
		background-position: center;
	}

	.overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 48px;
		background: linear-gradient(
			180deg,
			#01004500 0%,
			#010045cc 60%,
			#010045f0 100%
		);
	}

	.content {
		max-width: 700px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
	}

	.pill {
		background: #ffffff25;
		border-radius: 20px;
		padding: 6px 14px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1px;
		color: var(--white);
	}

	h2 {
		font-size: clamp(22px, 2.4vw, 26px);
		font-weight: 700;
		line-height: 1.3;
		color: var(--white);
	}

	.desc {
		font-size: 15px;
		line-height: 1.6;
		color: var(--periwinkle-soft);
	}

	@media (max-width: 640px) {
		.frame {
			height: 380px;
		}

		.overlay {
			padding: 24px;
		}
	}
</style>
